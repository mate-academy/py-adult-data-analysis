import numpy as np
import pandas as pd

# Task 0: Read and clean dataset
df = pd.read_csv("adult.csv")
df.replace("?", np.nan, inplace=True)
df.dropna(inplace=True)

# Task 1: Count men and women
men_count = df[df["Sex"] == "Male"].shape[0]
women_count = df[df["Sex"] == "Female"].shape[0]
print("Men count:", men_count)
print("Women count:", women_count)

# Task 2: Average age of men
avg_age_men = df[df["Sex"] == "Male"]["Age"].mean()
print("Average age of men:", avg_age_men)

# Task 3: Percentage of people from Poland
poland_count = df[df["Native Country"] == "Poland"].shape[0]
total_count = df.shape[0]
poland_percentage = (poland_count / total_count) * 100
print("Percentage of Polish people:", poland_percentage)

# Task 4: Mean and std deviation of age for >50K and <=50K earners
high_earners = df[df["Salary"] == ">50K"]
low_earners = df[df["Salary"] == "<=50K"]
print("Mean age of >50K earners:", high_earners["Age"].mean())
print("Std deviation of >50K earners:", high_earners["Age"].std())
print("Mean age of <=50K earners:", low_earners["Age"].mean())
print("Std deviation of <=50K earners:", low_earners["Age"].std())

# Task 5: People without higher education earning >50K
higher_education = ["Bachelors", "Prof-school", "Assoc-acdm", "Assoc-voc", "Masters", "Doctorate"]
no_higher_edu_high_salary = df[(~df["Education"].isin(higher_education)) & (df["Salary"] == ">50K")]
print("Count of non-higher-educated people earning >50K:", no_higher_edu_high_salary.shape[0])

# Task 6: Age statistics for each education level
age_stats_by_edu = df.groupby("Education")["Age"].describe()
print(age_stats_by_edu)

# Task 7: Compare salaries of married and non-married men
married_men = df[(df["Sex"] == "Male") & (df["Marital Status"].str.startswith("Married"))]
non_married_men = df[(df["Sex"] == "Male") & (~df["Marital Status"].str.startswith("Married"))]
print("Married men earning >50K:", married_men[married_men["Salary"] == ">50K"].shape[0])
print("Non-married men earning >50K:", non_married_men[non_married_men["Salary"] == ">50K"].shape[0])

# Task 8: Max working hours per week and count of people working that much
max_hours = df["Hours-per-week"].max()
people_max_hours = df[df["Hours-per-week"] == max_hours].shape[0]
print("Max hours per week:", max_hours)
print("People working max hours:", people_max_hours)

# Task 9: Correlation analysis
correlation_matrix = df.corr()
print(correlation_matrix)
